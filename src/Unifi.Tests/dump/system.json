          },
          "3002": {
            "action": "accept",
            "description": "Allow neighbor solicitation",
            "protocol": "ipv6-icmp",
            "icmpv6": { "type": "neighbor-solicitation" }
          },
          "3003": {
            "action": "accept",
            "description": "allow established/related sessions",
            "state": {
              "established": "enable",
              "invalid": "disable",
              "new": "disable",
              "related": "enable"
            }
          },
          "3004": {
            "action": "accept",
            "description": "Allow DHCPv6 (link-local)",
            "protocol": "udp",
            "destination": { "port": "546" },
            "source": { "address": "fe80::/10" }
          },
          "3005": {
            "action": "accept",
            "description": "Allow DHCPv6",
            "protocol": "udp",
            "destination": { "port": "546" },
            "source": { "port": "547" }
          },
          "3006": {
            "action": "accept",
            "description": "Allow router advertisements",
            "protocol": "ipv6-icmp",
            "icmpv6": { "type": "router-advertisement" }
          },
          "3007": {
            "action": "drop",
            "description": "drop invalid state",
            "state": {
              "established": "disable",
              "invalid": "enable",
              "new": "disable",
              "related": "disable"
            }
          }
        }
      },
      "WANv6_IN": {
        "default-action": "drop",
        "description": "packets from internet to intranet",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "allow established/related sessions",
            "state": {
              "established": "enable",
              "invalid": "disable",
              "new": "disable",
              "related": "enable"
