      "WANv6_LOCAL": {
        "default-action": "drop",
        "description": "packets from internet to gateway",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "Allow neighbor advertisements",
            "protocol": "ipv6-icmp",
