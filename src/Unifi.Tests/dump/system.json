    "name": {
      "AUTHORIZED_GUESTS": {
        "default-action": "drop",
        "description": "authorization check packets from guest network"
      },
      "GUEST_LOCAL": {
        "default-action": "drop",
        "description": "packets from guest network to gateway",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "allow DNS",
            "destination": { "port": "53" },
            "protocol": "tcp_udp"
          },
          "3002": {
            "action": "accept",
            "description": "allow ICMP",
            "protocol": "icmp"
          },
          "3003": {
            "action": "accept",
            "description": "allow to DHCP server",
            "source": { "port": "68" },
            "destination": { "port": "67" },
            "protocol": "udp"
          },
          "3004": {
            "action": "accept",
            "description": "allow to RADIUS authentication",
            "protocol": "udp",
            "destination": { "port": "1812" }
          },
          "3005": {
            "action": "accept",
            "description": "allow to RADIUS accounting",
            "protocol": "udp",
            "destination": { "port": "1813" }
          },
          "3006": {
            "action": "accept",
            "description": "allow redirects to redirector",
            "destination": { "group": { "port-group": "guest_portal_redirector_ports" } },
            "protocol": "tcp"
          }
        }
      },
      "GUEST_IN": {
        "default-action": "accept",
        "description": "packets from guest network",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "allow DNS packets to external name servers",
            "protocol": "tcp_udp",
            "destination": { "port": "53" }
          },
          "3002": {
            "action": "accept",
            "description": "allow packets to guest portal ports",
            "destination": {
              "group": {
                "address-group": "guest_portal_address",
                "port-group": "guest_portal_ports"
              }
            }
          },
          "3003": {
            "action": "accept",
            "description": "allow packets to captive portal",
            "protocol": "tcp",
            "destination": {
              "port": "443",
              "group": { "network-group": "captive_portal_subnets" }
            }
          },
          "3004": {
            "action": "accept",
            "description": "allow packets to allow subnets",
            "destination": { "group": { "address-group": "guest_pre_allow" } }
          },
          "3005": {
            "action": "drop",
            "description": "drop packets to restricted subnets",
            "destination": { "group": { "address-group": "guest_restricted" } }
          },
          "3006": {
            "action": "drop",
            "description": "drop packets to intranet",
            "destination": { "group": { "network-group": "corporate_network" } }
          },
          "3007": {
            "action": "drop",
            "description": "drop packets to remote user",
            "destination": { "group": { "network-group": "remote_user_vpn_network" } }
          },
          "3008": {
            "action": "drop",
            "description": "allow authorized and drop unauthorized",
            "destination": { "group": { "address-group": "authorized_guests" } }
          }
        }
      },
      "GUEST_OUT": {
        "default-action": "accept",
        "description": "packets forward to guest network"
      },
      "LAN_LOCAL": {
        "default-action": "accept",
        "description": "packets from intranet to gateway"
      },
      "LAN_IN": {
        "default-action": "accept",
        "description": "packets from intranet",
        "rule": {
          "6001": {
            "action": "accept",
            "description": "accounting defined network 192.168.2.0/24",
            "source": { "address": "192.168.2.0/24" }
          },
          "4000": {
            "action": "accept",
            "description": "OpenSSH",
            "protocol": "tcp",
            "destination": { "group": { "port-group": "660c5ba18d6d5f1535169c9b" } }
          },
          "4001": {
            "action": "accept",
            "description": "Unifi Connect Request",
            "protocol": "udp",
            "destination": { "group": { "port-group": "660d78ff8d6d5f153516b9cc" } }
          }
        }
      },
      "LAN_OUT": {
        "default-action": "accept",
        "description": "packets forward to intranet",
        "rule": {
          "6001": {
            "action": "accept",
            "description": "accounting defined network 192.168.2.0/24",
            "destination": { "address": "192.168.2.0/24" }
          }
        }
      },
      "WAN_LOCAL": {
        "default-action": "drop",
        "description": "packets from internet to gateway",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "allow established/related sessions",
            "state": {
              "established": "enable",
              "invalid": "disable",
              "new": "disable",
              "related": "enable"
            }
          },
          "3002": {
            "action": "drop",
            "description": "drop invalid state",
            "state": {
              "established": "disable",
              "invalid": "enable",
              "new": "disable",
              "related": "disable"
            }
          },
          "4000": {
            "action": "accept",
            "description": "OpenSSH",
            "protocol": "tcp",
            "destination": {
              "group": {
                "address-group": "660d64988d6d5f153516b7be",
                "port-group": "660c5ba18d6d5f1535169c9b"
              }
            }
          },
          "4001": {
            "action": "accept",
            "description": "IPSec",
            "protocol": "udp",
            "destination": {
              "group": {
                "address-group": "660d64988d6d5f153516b7be",
                "port-group": "660c5b618d6d5f1535169c97"
              }
            }
          }
        }
      },
      "WAN_IN": {
        "default-action": "drop",
        "description": "packets from internet to intranet",
        "rule": {
          "3001": {
            "action": "accept",
            "description": "allow established/related sessions",
            "state": {
              "established": "enable",
              "invalid": "disable",
              "new": "disable",
              "related": "enable"
            }
          },
          "3002": {
            "action": "drop",
            "description": "drop invalid state",
            "state": {
              "established": "disable",
              "invalid": "enable",
              "new": "disable",
              "related": "disable"
            }
          },
          "3003": {
            "action": "accept",
            "description": "PortForward [unifi.vitaliy.org]",
            "destination": {
              "address": "192.168.2.12",
              "port": "8443"
            },
            "protocol": "tcp"
          }
        }
      },
      "WAN_OUT": {
        "default-action": "accept",
        "description": "packets to internet"
      }
